---
import Icon from "./Icon.astro";
---

<dialog id="lightbox" aria-label="Galeria de fotos ampliada" class="m-0 h-full max-h-none w-full max-w-none bg-ink/95 p-0 text-cream backdrop:bg-ink/95">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between px-4 py-3">
      <p id="lb-count" class="text-sm text-mute" aria-live="polite"></p>
      <button type="button" id="lb-close" class="p-2 text-gold-hi" aria-label="Fechar galeria"><Icon name="close" class="h-7 w-7" /></button>
    </div>
    <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16" id="lb-stage">
      <button type="button" id="lb-prev" class="absolute left-1 z-10 bg-ink/60 p-2 text-gold-hi sm:left-4" aria-label="Foto anterior"><Icon name="prev" class="h-8 w-8" /></button>
      <img id="lb-img" alt="" class="max-h-full max-w-full object-contain" />
      <button type="button" id="lb-next" class="absolute right-1 z-10 bg-ink/60 p-2 text-gold-hi sm:right-4" aria-label="Próxima foto"><Icon name="next" class="h-8 w-8" /></button>
    </div>
    <p id="lb-alt" class="px-4 py-4 text-center text-sm text-mute"></p>
  </div>
</dialog>

<script>
  const dlg = document.getElementById("lightbox") as HTMLDialogElement;
  const img = document.getElementById("lb-img") as HTMLImageElement;
  const count = document.getElementById("lb-count")!;
  const cap = document.getElementById("lb-alt")!;
  const triggers = [...document.querySelectorAll<HTMLButtonElement>("[data-lightbox]")];
  let idx = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    idx = (i + triggers.length) % triggers.length;
    const t = triggers[idx];
    img.classList.remove("is-swapping");
    void img.offsetWidth;
    if (dlg.open) img.classList.add("is-swapping");
    img.src = t.dataset.full!;
    img.alt = t.dataset.alt ?? "";
    cap.textContent = t.dataset.alt ?? "";
    count.textContent = `${idx + 1} de ${triggers.length}`;
  }
  function open(i: number, from: HTMLElement) {
    opener = from;
    show(i);
    dlg.showModal();
  }
  triggers.forEach((t, i) => t.addEventListener("click", () => open(i, t)));
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  function fechar() {
    if (!dlg.open || dlg.classList.contains("is-closing")) return;
    if (reduce.matches && document.documentElement.dataset.motion !== "on") return dlg.close();
    dlg.classList.add("is-closing");
    // 260ms: um pouco mais que a animação lb-out (250ms)
    setTimeout(() => {
      dlg.classList.remove("is-closing");
      dlg.close();
    }, 260);
  }
  dlg.addEventListener("cancel", (e) => {
    e.preventDefault();
    fechar();
  });
  document.getElementById("lb-close")!.addEventListener("click", fechar);
  document.getElementById("lb-prev")!.addEventListener("click", () => show(idx - 1));
  document.getElementById("lb-next")!.addEventListener("click", () => show(idx + 1));
  dlg.addEventListener("close", () => opener?.focus());
  dlg.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(idx - 1);
    if (e.key === "ArrowRight") show(idx + 1);
  });
  // clique fora da foto fecha
  document.getElementById("lb-stage")!.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) fechar();
  });
  // swipe
  let x0: number | null = null;
  dlg.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener("touchend", (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>
