---
import { Image } from "astro:assets";
import logo from "../assets/logo.jpg";
import { site } from "../data/site";
const s = site.sobre;
---

<section id="sobre" class="section bg-ink-2">
  <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div data-reveal="left">
      <h2 class="text-5xl text-cream sm:text-6xl">{s.titulo}</h2>
      <div class="mt-5 h-px w-20 bg-gold" aria-hidden="true"></div>
      <blockquote class="mt-8 border-l border-gold pl-5 font-display text-2xl italic text-gold-hi sm:text-3xl">
        {s.destaque}
      </blockquote>
      <div class="mt-8 space-y-4 text-mute">
        {s.paragrafos.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div data-reveal="right" data-reveal-delay="150" class="flex justify-center">
      <div class="logo-glow isolate w-4/5 max-w-md">
        <Image src={logo} alt="Logo Flor de Maio festas e eventos, com flor de lótus dourada" widths={[360, 560, 800]} sizes="(min-width:1024px) 480px, 80vw" loading="lazy" class="w-full rounded-full shadow-[0_0_0_1px_rgb(201_163_91/0.4)]" />
      </div>
    </div>
  </div>
</section>
