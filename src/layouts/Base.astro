---
import "../styles/global.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/great-vibes/400.css";
import "@fontsource-variable/montserrat";
import { getImage } from "astro:assets";
import hero from "../assets/hero.webp";
import { site, indexavel, comBase } from "../data/site";

const { title = `${site.nome} | Salão de festas em Curitiba`, description = site.descricao } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImg = await getImage({ src: hero, width: 1200, height: 630, fit: "cover", format: "jpg" });
const ogUrl = Astro.site ? new URL(ogImg.src, Astro.site).href : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["EventVenue", "LocalBusiness"],
  name: site.nome,
  description: site.descricao,
  telephone: site.whatsapp.tel,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.endereco.rua,
    addressLocality: site.endereco.cidade,
    addressRegion: site.endereco.uf,
    postalCode: site.endereco.cep,
    addressCountry: "BR",
  },
  geo: { "@type": "GeoCoordinates", latitude: site.endereco.lat, longitude: site.endereco.lng },
  maximumAttendeeCapacity: 80,
  sameAs: [site.instagram.link],
  ...(canonical && { url: canonical }),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // ?animacao=on força as animações mesmo com "reduzir movimento" ativo no sistema; ?animacao=off desfaz
      try {
        var q = new URLSearchParams(location.search).get("animacao");
        if (q === "on") localStorage.setItem("fm-animacao", "on");
        if (q === "off") localStorage.removeItem("fm-animacao");
        if (localStorage.getItem("fm-animacao") === "on") document.documentElement.dataset.motion = "on";
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0b09" />
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={comBase("favicon.png")} />
    <link rel="apple-touch-icon" href={comBase("apple-touch-icon.png")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-gold focus:text-ink focus:px-4 focus:py-2">Ir para o conteúdo</a>
    <slot />
    <script>
      // Rolagem suave por JS: só quando o sistema desliga a nativa (modo ?animacao=on)
      if (matchMedia("(prefers-reduced-motion: reduce)").matches && document.documentElement.dataset.motion === "on") {
        document.addEventListener("click", (ev) => {
          const a = (ev.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
          const alvo = a && a.hash.length > 1 ? document.getElementById(a.hash.slice(1)) : null;
          if (!a || !alvo || ev.defaultPrevented) return;
          ev.preventDefault();
          const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          const y0 = scrollY;
          const y1 = Math.max(0, alvo.getBoundingClientRect().top + y0 - offset);
          const dur = Math.min(1100, 450 + Math.abs(y1 - y0) / 4);
          const t0 = performance.now();
          const passo = (t: number) => {
            const k = Math.min(1, (t - t0) / dur);
            const e = 1 - Math.pow(1 - k, 4);
            scrollTo({ top: y0 + (y1 - y0) * e, behavior: "instant" });
            if (k < 1) requestAnimationFrame(passo);
            else history.pushState(null, "", a.hash);
          };
          requestAnimationFrame(passo);
        });
      }

      // Revelação ao rolar: um único IntersectionObserver, cada elemento anima uma vez
      const css = getComputedStyle(document.documentElement);
      const stagger = parseFloat(css.getPropertyValue("--motion-stagger")) || 100;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches && document.documentElement.dataset.motion !== "on";

      document.querySelectorAll<HTMLElement>("[data-reveal-stagger]").forEach((grupo) => {
        grupo.querySelectorAll<HTMLElement>(":scope > [data-reveal]").forEach((el, i) => {
          if (!el.dataset.revealDelay) el.style.setProperty("--d", `${i * stagger}ms`);
        });
      });
      const alvos = document.querySelectorAll<HTMLElement>("[data-reveal], [data-draw]");
      alvos.forEach((el) => {
        if (el.dataset.revealDelay) el.style.setProperty("--d", `${el.dataset.revealDelay}ms`);
      });

      if (reduce || !("IntersectionObserver" in window)) {
        alvos.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
        );
        alvos.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
